{
  "name": "expo-weather",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --quiet",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --coverage",
    "test:expo": "EXPO_UI_TESTS=1 jest --config jest.expo.config.js --coverage",
    "doctor": "npx expo-doctor@latest",
    "expo:align": "node scripts/upgrade-expo.js",
    "expo:align:write": "node scripts/upgrade-expo.js --write",
    "validate": "npm run typecheck && npm test -- --runInBand && npm run doctor && npm run web:export"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/material-top-tabs": "7.6.14",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.7",
    "expo": "54.0.36",
    "expo-location": "19.0.8",
    "expo-status-bar": "3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/react": "19.1.17",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-expo": "54.0.12",
    "eslint": "8.57.1",
    "eslint-config-universe": "16.0.0",
    "jest": "29.7.0",
    "jest-expo": "54.0.17",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.0.8",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.17.0",
  "expo": {
    "install": {
      "exclude": [
        "react-server-dom-webpack"
      ]
    }
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
